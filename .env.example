# Groq API key (free): https://console.groq.com/keys
# Read only by the server (/api/triage), never sent to the browser.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (see console.groq.com for what your account offers)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: post High-urgency messages to a Slack channel (Incoming Webhook URL)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
